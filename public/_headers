/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://accounts.aidenjang.com
/s/*
  X-Robots-Tag: noindex, nofollow
/lists*
  X-Robots-Tag: noindex
/settings
  X-Robots-Tag: noindex
/search
  X-Robots-Tag: noindex
/patterns
  X-Robots-Tag: noindex

/capture
  X-Robots-Tag: noindex, nofollow
/quick
  X-Robots-Tag: noindex, nofollow

/inbox
  X-Robots-Tag: noindex, nofollow
