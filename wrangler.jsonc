{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "worth",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "AUTH_URL": "https://accounts.aidenjang.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "worth",
      "database_id": "04c5ae25-6c62-4460-aae0-ccd6b36f25c6",
      "migrations_dir": "migrations",
    },
    {
      "binding": "worth",
      "database_name": "worth",
      "database_id": "04c5ae25-6c62-4460-aae0-ccd6b36f25c6",
    },
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "routes": [
    {
      "pattern": "worth.aidenjang.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
