{
  "name": "worth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "node scripts/prepare-ocr.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-ocr.mjs && pnpm typecheck && vite build && node scripts/prepare-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "wrangler types && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm check:core && pnpm e2e",
    "db:migrate:local": "wrangler d1 migrations apply worth --local",
    "db:migrate:remote": "wrangler d1 migrations apply worth --remote",
    "deploy": "pnpm check && pnpm db:migrate:remote && wrangler deploy",
    "verify:live": "node scripts/verify-live.mjs",
    "deploy:only": "pnpm build && pnpm release:built",
    "lint": "eslint . --max-warnings 0",
    "deadcode": "knip",
    "check:core": "pnpm run security:check && pnpm format:check && pnpm lint && pnpm deadcode && pnpm test && pnpm build",
    "e2e": "playwright test",
    "release:built": "pnpm db:migrate:remote && wrangler deploy --config dist/worth/wrangler.json",
    "security:check": "pnpm audit --audit-level=low"
  },
  "dependencies": {
    "@aidenjang/auth-client": "^0.2.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.2",
    "@zxing/library": "0.23.0",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  }
}
