{
  "name": "worth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "wrangler types && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm test && pnpm build",
    "db:migrate:local": "wrangler d1 migrations apply worth --local",
    "db:migrate:remote": "wrangler d1 migrations apply worth --remote",
    "deploy": "pnpm check && pnpm db:migrate:remote && wrangler deploy",
    "verify:live": "node scripts/verify-live.mjs",
    "deploy:only": "pnpm build && pnpm db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "@aidenjang/auth-client": "^0.2.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.83.0",
    "hono": "^4.13.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.9.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.122.0"
  }
}
